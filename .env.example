# MarginOptimizer — local environment template
# Copy to .env and fill in. NEVER commit .env.

# --- Core AWS ---
AWS_REGION=eu-central-1
AWS_PROFILE=mo-dev

# --- Bedrock ---
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# --- Business thresholds ---
MIN_MARGIN_EUR=30
MAX_DEPARTURE_SHIFT_HOURS=3
MAX_LAYOVER_HOURS=4

# --- Slack (staging workspace for dev) ---
SLACK_BOT_TOKEN=xoxb-REPLACE_ME
SLACK_SIGNING_SECRET=REPLACE_ME
SLACK_CHANNEL_ID=C01DEV0000

# --- Aurora (read via Secrets Manager; this URL is for local forwarding only) ---
YIELD_DB_URL=postgresql+psycopg2://user:pass@localhost:5433/margin_optimizer

# --- Step Functions ---
SAGA_ARN=arn:aws:states:eu-central-1:REPLACE_ME:stateMachine:MoSaga-dev

# --- SQS ---
PNR_QUEUE_URL=
PNR_DLQ_URL=

# --- Traffics ---
TRAFFICS_API_KEY=REPLACE_ME

# --- Safety flags ---
# DRY_RUN=true → modify Lambda logs intended mutation, skips PATCH.
# Keep true in dev. CI flips to false only for specific integration tests.
DRY_RUN=true

# --- Runtime behavior ---
ENV=dev
LOG_LEVEL=DEBUG
BYPASS_TOOL_CONSENT=true
PROMPT_VERSION=v1
